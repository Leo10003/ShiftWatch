{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShiftWatch anonymized gold case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "scenario", "expected", "privacy"],
  "properties": {
    "schemaVersion": {"const": 1},
    "caseId": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "scenario": {"type": "string", "minLength": 1},
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rotaWeekStart", "shifts"],
      "properties": {
        "rotaWeekStart": {"type": "string", "format": "date"},
        "shifts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["weekday", "start", "identityExpected"],
            "properties": {
              "weekday": {"type": "integer", "minimum": 1, "maximum": 7},
              "start": {"type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"},
              "identityExpected": {"type": "boolean"},
              "blockId": {"type": "string"}
            }
          }
        }
      }
    },
    "privacy": {"const": "synthetic-or-anonymized"},
    "notes": {"type": "string"}
  }
}
